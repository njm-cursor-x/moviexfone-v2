# Copy to .env and fill in. Never commit .env. The repo is public.
# The only secret this demo needs is an xAI key, and only for the live voice path.

XAI_API_KEY=

# Set to 1 to open the realtime voice bridge. Requires XAI_API_KEY and a
# MOVIEXFONE_TOOL_SECRET of at least 16 bytes. The process exits otherwise.
MOVIEXFONE_LIVE_VOICE=0

# Set to 1 to fetch Alamo and Nitehawk (at startup and about every 45 minutes)
# and Assemble for one title when that title is asked and its cache is older
# than MOVIEXFONE_ASSEMBLE_TTL. Leave 0 to use the bundled fixtures. Live mode
# does not load those fixtures.
MOVIEXFONE_LIVE_DATA=0

# Shared secret for tool calls (header X-MovieXFone-Secret). Required, and at
# least 16 bytes, when MOVIEXFONE_BIND is not localhost or when live voice is
# on. The browser page does not put this secret on the socket. It asks
# POST /v1/voice/ticket for a one-minute ticket and connects with ?ticket=.
# The Docker image binds 0.0.0.0.
MOVIEXFONE_TOOL_SECRET=

# Optional overrides.
# MOVIEXFONE_DB=var/moviexfone.db
# MOVIEXFONE_BIND=127.0.0.1
# MOVIEXFONE_PORT=8000
# MOVIEXFONE_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# MOVIEXFONE_RATE_LIMIT=60
# MOVIEXFONE_DATA=data
